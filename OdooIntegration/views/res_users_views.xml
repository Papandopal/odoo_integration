<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="view_users_form_simple_modif_external_id" model="ir.ui.view">
		<field name="name">res.users.preferences.external_user_id</field>
		<field name="model">res.users</field>
		<field name="inherit_id" ref="base.view_users_form_simple_modif"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='email']" position="after">
				<field name="external_user_id"
                       placeholder="e.g. 42"
                       help="Your ID from the course project app."/>
			</xpath>
		</field>
	</record>

</odoo>