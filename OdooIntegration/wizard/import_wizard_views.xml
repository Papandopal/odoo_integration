<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_wizard_form" model="ir.ui.view">
        <field name="name">import.wizard.form</field>
        <field name="model">import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Positions">
                <group>
                    <field name="external_user_id"/>
                    <field name="position_ids"/>
                </group>
                <footer>
                    <button name="action_import"
                            type="object"
                            string="Import"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Positions</field>
        <field name="res_model">import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
